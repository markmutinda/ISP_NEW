# -*- text -*-
server default {
    listen {
        type = auth
        ipaddr = *
        port = 0
    }

    listen {
        type = acct
        ipaddr = *
        port = 0
    }

    # 1. Authorization - Find the tenant and check password
    authorize {
        filter_username
        preprocess

        # --- THE BRAIN: DYNAMIC SCHEMA LOOKUP ---
        update control {
            Tmp-String-0 := "%{sql:SELECT t.schema_name FROM core_tenant t JOIN core_globalroutermap g ON t.id = g.tenant_id WHERE g.nas_ip = '%{NAS-IP-Address}' AND g.is_active = true LIMIT 1}"
        }

        # Reject if the router is not registered in our Global Phonebook
        if (&control:Tmp-String-0 == "") {
            reject
        }

        chap
        sql

        if (&Framed-Protocol == PPP) {
            # PPPoE: expired => restricted portal session, never reject.
            # Fail-closed: any SQL failure yields a walled session, not free internet.
            update control {
                Tmp-String-1 := "%{sql:SELECT CASE WHEN COUNT(*) > 0 THEN 'y' ELSE 'n' END FROM %{control:Tmp-String-0}.radcheck WHERE username = '%{User-Name}' AND attribute = 'Expiration' AND TO_TIMESTAMP(value, 'Mon DD YYYY HH24:MI:SS') < NOW()}"
            }
            if (&control:Tmp-String-1 != "n") {
                update reply {
                    Mikrotik-Address-List := "netily-expired"
                    Mikrotik-Rate-Limit := "512k/512k"
                    Session-Timeout := 1800
                    Mikrotik-Total-Limit !* ANY
                }
            }
        }
        else {
            expiration
        }

        logintime
        pap
    }

    # 2. Authentication - verify password
    authenticate {
        Auth-Type PAP {
            pap
        }
        Auth-Type CHAP {
            chap
        }
        Auth-Type MS-CHAP {
            mschap
        }
    }

    # 3. Pre-accounting
    preacct {
        preprocess
        acct_unique
    }

    # 4. Accounting - Record data usage
    accounting {
        update control {
            Tmp-String-0 := "%{sql:SELECT t.schema_name FROM core_tenant t JOIN core_globalroutermap g ON t.id = g.tenant_id WHERE g.nas_ip = '%{NAS-IP-Address}' AND g.is_active = true LIMIT 1}"
        }

        if (&control:Tmp-String-0 == "") {
            reject
        }
        sql
    }

    session {
        update control {
            Tmp-String-0 := "%{sql:SELECT t.schema_name FROM core_tenant t JOIN core_globalroutermap g ON t.id = g.tenant_id WHERE g.nas_ip = '%{NAS-IP-Address}' AND g.is_active = true LIMIT 1}"
        }

        if (&control:Tmp-String-0 != "") {
            sql
        }
    }

    post-auth {
        update control {
            Tmp-String-0 := "%{sql:SELECT t.schema_name FROM core_tenant t JOIN core_globalroutermap g ON t.id = g.tenant_id WHERE g.nas_ip = '%{NAS-IP-Address}' AND g.is_active = true LIMIT 1}"
        }

        if (&control:Tmp-String-0 != "") {
            sql
        }

        Post-Auth-Type REJECT {
            if (&control:Tmp-String-0 != "") {
                sql
            }
            attr_filter.access_reject
        }
    }
}