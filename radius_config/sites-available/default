# -*- text -*-
server default {
    listen {
        type = auth
        ipaddr = *
        port = 0
    }

    listen {
        type = acct
        ipaddr = *
        port = 0
    }

    # 1. Authorization - Find the tenant and check password
    authorize {
        filter_username
        preprocess
        
        # --- THE BRAIN: DYNAMIC SCHEMA LOOKUP ---
        update control {
            Tmp-String-0 := "%{sql:SELECT t.schema_name FROM core_tenant t JOIN core_globalroutermap g ON t.id = g.tenant_id WHERE g.nas_ip = '%{NAS-IP-Address}' AND g.is_active = true LIMIT 1}"
        }

        # Reject if the router is not registered in our Global Phonebook
        if (&control:Tmp-String-0 == "") {
            reject
        }

        sql
        expiration
        logintime
        
        # --- FIXED: Added pap module at the bottom of authorize section ---
        # This is required for PAP authentication to work properly
        pap
    }

    # 2. Authentication - verify password
    authenticate {
        Auth-Type PAP {
            pap
        }
        Auth-Type CHAP {
            chap
        }
        Auth-Type MS-CHAP {
            mschap
        }
    }

    # 3. Pre-accounting
    preacct {
        preprocess
        acct_unique
    }

    # 4. Accounting - Record data usage
    accounting {
        # Re-verify schema for accounting packets
        update control {
            Tmp-String-0 := "%{sql:SELECT t.schema_name FROM core_tenant t JOIN core_globalroutermap g ON t.id = g.tenant_id WHERE g.nas_ip = '%{NAS-IP-Address}' AND g.is_active = true LIMIT 1}"
        }

        if (&control:Tmp-String-0 != "") {
            sql
        }
    }

    # 5. Session - Simultaneous use check
    session {
        sql
    }

    # 6. Post-authentication - Log login attempts
    post-auth {
        sql
        
        Post-Auth-Type REJECT {
            sql
            attr_filter.access_reject
        }
    }
}