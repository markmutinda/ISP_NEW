# ────────────────────────────────────────────────────────────────
# FreeRADIUS SQL Configuration (FLAT SYNTAX - REQUIRED FOR ACCOUNTING)
# ────────────────────────────────────────────────────────────────
# IMPORTANT: This file uses flat variable syntax for accounting queries.
# Do NOT use nested blocks like: accounting { start { ... } }
# FreeRADIUS 3.x requires flat variables: accounting_start_query = "..."
# ────────────────────────────────────────────────────────────────

sql {
    driver = "rlm_sql_postgresql"
    dialect = "postgresql"

    # Database connection settings (substituted by envsubst in entrypoint)
    server = "${DB_HOST}"
    port = ${DB_PORT}
    login = "${DB_USER}"
    password = "${DB_PASSWORD}"
    radius_db = "${DB_NAME}"
    
    # IMPORTANT: Stay in public schema to find the routers, then we switch per-user
    # The core_globalroutermap table lives in public, not tenant schemas
    connect_query = "SET search_path TO public"

    # Connection Pool Settings
    pool {
        start = 5
        min = 3
        max = 32
        spare = 3
        uses = 0
        lifetime = 0
        idle_timeout = 60
    }

    # Feature Flags
    read_clients = yes
    read_groups = yes
    delete_stale_sessions = yes

    # SQL User Name - Used in query expansion
    sql_user_name = "%{User-Name}"

    # ───────────────────────────────────────────────────────────────────────────
    # CLIENT QUERY - Load NAS devices from database (MUST BE IN PUBLIC SCHEMA)
    # ───────────────────────────────────────────────────────────────────────────
    # This reads from core_globalroutermap which lives in the public schema
    client_query = "SELECT id, nas_ip AS nasname, nas_ip AS shortname, 'other' AS type, nas_secret AS secret FROM core_globalroutermap WHERE is_active = true"

    # ═══════════════════════════════════════════════════════════════════════════
    # DYNAMIC QUERY INCLUSION
    # This line pulls in all your authorize_check_query, authorize_reply_query,
    # accounting_start_query, accounting_update_query, accounting_stop_query,
    # postauth_query, etc. from queries.conf
    # These queries add the %{control:Tmp-String-0} schema prefix for multi-tenancy
    # ═══════════════════════════════════════════════════════════════════════════
    $INCLUDE /etc/freeradius/mods-config/sql/main/postgresql/queries.conf
}