global
    log stdout format raw local0
    maxconn 4096
   

defaults
    log global
    mode tcp
    option tcplog
    timeout connect 5s
    timeout client 30s
    timeout server 30s

# Stats page (internal only)
frontend stats
    bind *:8404
    stats enable
    stats uri /stats
    stats refresh 10s

