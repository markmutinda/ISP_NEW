# ═══════════════════════════════════════════════════════════════════════════════
#  NETILY ISP MANAGEMENT - ENVIRONMENT CONFIGURATION TEMPLATE
# ═══════════════════════════════════════════════════════════════════════════════
# 
#  SETUP INSTRUCTIONS:
#  1. Copy this file to `.env`:  cp .env.example .env
#  2. Replace all placeholder values with your actual credentials
#  3. NEVER commit the .env file to git (it's in .gitignore)
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
#  DJANGO SETTINGS
# ─────────────────────────────────────────────────────────────────
# Generate a new secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE_ME_generate_a_random_50_char_string
DJANGO_SECRET_KEY=CHANGE_ME_generate_a_random_50_char_string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=YOUR_DROPLET_IP,YOUR_DOMAIN.com,*.YOUR_DOMAIN.com,localhost
DJANGO_SETTINGS_MODULE=config.settings.production

# ─────────────────────────────────────────────────────────────────
#  DATABASE (PostgreSQL)
# ─────────────────────────────────────────────────────────────────
DB_NAME=netily_isp
DB_USER=netily
DB_PASSWORD=CHANGE_ME_use_strong_password
DB_HOST=localhost
DB_PORT=5432

# ─────────────────────────────────────────────────────────────────
#  REDIS (for Celery and caching)
# ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────────
#  EMAIL CONFIGURATION
# ─────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=CHANGE_ME_your_email@gmail.com
EMAIL_HOST_PASSWORD=CHANGE_ME_your_app_password
DEFAULT_FROM_EMAIL=Netily <noreply@netily.io>

# ─────────────────────────────────────────────────────────────────
#  PAYHERO CONFIGURATION (M-Pesa STK Push)
# ─────────────────────────────────────────────────────────────────
# Get your credentials from: https://app.payhero.co.ke/settings/api
PAYHERO_API_USERNAME=CHANGE_ME_your_payhero_username
PAYHERO_API_PASSWORD=CHANGE_ME_your_payhero_password
PAYHERO_ENVIRONMENT=sandbox
PAYHERO_CHANNEL_ID=CHANGE_ME_your_channel_id
PAYHERO_WEBHOOK_SECRET=CHANGE_ME_generate_random_secret

# Callback URLs (update with your domain in production)
PAYHERO_CALLBACK_URL=https://your-domain.com/api/v1/webhooks/payhero/
PAYHERO_BILLING_CALLBACK=https://your-domain.com/api/v1/webhooks/payhero/billing/

# ─────────────────────────────────────────────────────────────────
#  SMS PROVIDERS (Choose one or both)
# ─────────────────────────────────────────────────────────────────
# Africa's Talking
AFRICASTALKING_API_KEY=CHANGE_ME_your_api_key
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=NETILY

# Twilio (alternative)
TWILIO_ACCOUNT_SID=CHANGE_ME_your_account_sid
TWILIO_AUTH_TOKEN=CHANGE_ME_your_auth_token
TWILIO_PHONE_NUMBER=+254XXXXXXXXX

# ─────────────────────────────────────────────────────────────────
#  FREERADIUS DATABASE (for PPPoE/Hotspot auth)
# ─────────────────────────────────────────────────────────────────
RADIUS_DB_NAME=radius
RADIUS_DB_USER=radius
RADIUS_DB_PASSWORD=CHANGE_ME_radius_password
RADIUS_DB_HOST=localhost
RADIUS_DB_PORT=5432

# ─────────────────────────────────────────────────────────────────
#  FRONTEND & SECURITY
# ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─────────────────────────────────────────────────────────────────
#  NETILY PLATFORM SETTINGS
# ─────────────────────────────────────────────────────────────────
NETILY_COMMISSION_RATE=0.05

# ─────────────────────────────────────────────────────────────────
#  DOCKER / DIGITALOCEAN PRODUCTION
# ─────────────────────────────────────────────────────────────────
# CORS origins the API accepts (comma-separated)
CORS_ALLOWED_ORIGINS=https://netily.vercel.app,https://YOUR_DOMAIN.com

# Base domain used for new tenant subdomains (e.g. acme.netily.co.ke)
TENANT_BASE_DOMAIN=YOUR_DOMAIN.com

# Domain + Certbot (used by deploy script)
DOMAIN=YOUR_DOMAIN.com
CERTBOT_EMAIL=admin@YOUR_DOMAIN.com

# The URL of your Django Backend API (MUST include https://)
BASE_URL=https://api.netily.co.ke

# The URL of your React/Next.js Frontend (MUST include https://)
FRONTEND_URL=https://netily.co.ke

# The OpenVPN Subnet Gateway (Matches vpn_provisioning_service)
VPN_GATEWAY_IP=10.8.0.1

# OpenVPN management host (container name for internal Docker networking)
OPENVPN_MANAGEMENT_HOST=netily-openvpn

# RADIUS shared secret (used by docker-compose)
RADIUS_SECRET=CHANGE_ME_radius_shared_secret
RADIUS_DOCKER_SECRET=CHANGE_ME_radius_shared_secret
RADIUS_CLIENTS=0.0.0.0/0
# =================================================================
# PLATFORM SUPERADMIN (ensure_superadmin management command)
# =================================================================
SUPERADMIN_EMAIL=admin@netily.co.ke
SUPERADMIN_PASSWORD=CHANGE_ME_strong_password
SUPERADMIN_FIRST_NAME=Netily
SUPERADMIN_LAST_NAME=Admin

# OTP / Email Delivery
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_LOGIN_MAX_RESENDS=5
OTP_EXEMPT_EMAILS=admin@netily.co.ke
EMAIL_TIMEOUT=10
# Optional Resend (recommended for fast delivery)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Netily <support@netily.co.ke>

